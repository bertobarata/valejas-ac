# ─────────────────────────────────────────────────────────────────────────────
# VALEJAS AC — Variáveis de Ambiente
#
# 1. Copia este ficheiro para .env.local  →  cp .env.local.example .env.local
# 2. Preenche os valores abaixo
# 3. Nunca commites o ficheiro .env.local (já está no .gitignore)
# ─────────────────────────────────────────────────────────────────────────────

# ── Sanity CMS ────────────────────────────────────────────────────────────────
# Obtém em https://manage.sanity.io → seleciona o projeto → Settings → API

# ID do projeto (visível no URL: manage.sanity.io/projects/XXXXXXXXX)
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Dataset — por defeito "production"
NEXT_PUBLIC_SANITY_DATASET=production

# Token de API (apenas necessário para mutações server-side, ex: formulário de sócios)
# Cria em manage.sanity.io → API → Tokens → Add API token → Editor
# NÃO usar prefixo NEXT_PUBLIC_ — este token é secreto
SANITY_API_TOKEN=
