# ─────────────────────────────────────────────────────────────────────────────
# VALEJAS AC — Variáveis de Ambiente
#
# 1. Copia este ficheiro para .env.local  →  cp .env.local.example .env.local
# 2. Preenche os valores abaixo
# 3. Nunca commites o ficheiro .env.local (já está no .gitignore)
# ─────────────────────────────────────────────────────────────────────────────

# ── Sanity CMS ────────────────────────────────────────────────────────────────
# Obtém em https://manage.sanity.io → seleciona o projeto → Settings → API

# ID do projeto (visível no URL: manage.sanity.io/projects/XXXXXXXXX)
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Dataset — por defeito "production"
NEXT_PUBLIC_SANITY_DATASET=production

# Token de API (apenas necessário para mutações server-side, ex: formulário de sócios)
# Cria em manage.sanity.io → API → Tokens → Add API token → Editor
# NÃO usar prefixo NEXT_PUBLIC_ — este token é secreto
SANITY_API_TOKEN=

# ── Formspree (formulários: contacto, inscrição sócios, newsletter) ───────────
# Cria um form em https://formspree.io → copia o endpoint (formspree.io/f/xxxxxxxx)
# Sem isto, os formulários mostram erro em vez de enviar.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# ── Site ──────────────────────────────────────────────────────────────────────
# URL público (usado nos links dos comunicados partilhados nas redes)
NEXT_PUBLIC_SITE_URL=https://valejasac.pt

# ── Comunicado → Redes Sociais (Meta Graph API) ───────────────────────────────
# SEM estes valores o fan-out corre em DRY-RUN (demo): nada é publicado a sério.
# Requer: Página Facebook do clube + conta Instagram Business ligada +
#         app Meta Developer + Page Access Token de longa duração.
# Permissões: pages_manage_posts, instagram_content_publish, pages_read_engagement.
META_GRAPH_VERSION=v21.0
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=
# Força modo demo mesmo com tokens presentes (=1)
META_DRY_RUN=

# Segredo partilhado do webhook Sanity (Authorization: Bearer <secret>)
SANITY_WEBHOOK_SECRET=
