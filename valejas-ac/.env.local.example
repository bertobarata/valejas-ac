# ─────────────────────────────────────────────────────────────────────────────
# VALEJAS AC — Variáveis de Ambiente
#
# 1. Copia este ficheiro para .env.local  →  cp .env.local.example .env.local
# 2. Preenche os valores abaixo
# 3. Nunca commites o ficheiro .env.local (já está no .gitignore)
# ─────────────────────────────────────────────────────────────────────────────

# ── Sanity CMS ────────────────────────────────────────────────────────────────
# Obtém em https://manage.sanity.io → seleciona o projeto → Settings → API

# ID do projeto (visível no URL: manage.sanity.io/projects/XXXXXXXXX)
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Dataset — por defeito "production"
NEXT_PUBLIC_SANITY_DATASET=production

# Token de API (apenas necessário para mutações server-side, ex: formulário de sócios)
# Cria em manage.sanity.io → API → Tokens → Add API token → Editor
# NÃO usar prefixo NEXT_PUBLIC_ — este token é secreto
SANITY_API_TOKEN=

# ── Formspree (formulários: contacto, inscrição sócios, newsletter) ───────────
# Cria um form em https://formspree.io → copia o endpoint (formspree.io/f/xxxxxxxx)
# Sem isto, os formulários mostram erro em vez de enviar.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# ── Site ──────────────────────────────────────────────────────────────────────
# URL público (usado nos links dos comunicados partilhados nas redes)
NEXT_PUBLIC_SITE_URL=https://valejasac.pt

# ── Comunicado → Redes Sociais (Meta Graph API) ───────────────────────────────
# SEM estes valores o fan-out corre em DRY-RUN (demo): nada é publicado a sério.
# Requer: Página Facebook do clube + conta Instagram Business ligada +
#         app Meta Developer + Page Access Token de longa duração.
# Permissões: pages_manage_posts, instagram_content_publish, pages_read_engagement.
META_GRAPH_VERSION=v21.0
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=
# Força modo demo mesmo com tokens presentes (=1)
META_DRY_RUN=

# Segredo partilhado do webhook Sanity (Authorization: Bearer <secret>)
SANITY_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────
# PAGAMENTOS DO CLUBE (inscrição de sócio)
# Alterar aqui e na Vercel se o clube mudar de conta ou de número.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLUBE_IBAN=
NEXT_PUBLIC_CLUBE_MBWAY=
NEXT_PUBLIC_CLUBE_TITULAR=Valejas Atlético Clube
# Só com gateway (Ifthenpay/Easypay):
NEXT_PUBLIC_CLUBE_ENTIDADE=
# Métodos visíveis no formulário, por ordem:
#   mbway | transferencia | referencia | debito-direto
NEXT_PUBLIC_PAGAMENTOS_ATIVOS=mbway,transferencia

# ─────────────────────────────────────────────────────────────
# EMAIL DAS INSCRIÇÕES
# EMAIL_PROVIDER=log  → escreve no terminal, não envia (dev)
# EMAIL_PROVIDER=resend → envia a sério
# ─────────────────────────────────────────────────────────────
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_REMETENTE=
EMAIL_CLUBE=

# ─────────────────────────────────────────────────────────────
# TAXA DE PAGAMENTO ONLINE
# Custo do gateway repassado ao sócio. Fixa em € + % do valor.
# Tudo a 0 → a taxa desaparece do site.
# ⚠️ O DL 3/2010 e a PSD2 restringem a cobrança de encargos ao
#    consumidor pelo uso de instrumentos de pagamento. Confirmar
#    com a contabilidade do clube antes de ativar.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_TAXA_MBWAY_FIXA=0
NEXT_PUBLIC_TAXA_MBWAY_PCT=0
NEXT_PUBLIC_TAXA_REFERENCIA_FIXA=0
NEXT_PUBLIC_TAXA_REFERENCIA_PCT=0

# ─────────────────────────────────────────────────────────────
# GATEWAY DE PAGAMENTO (Ifthenpay)
# ─────────────────────────────────────────────────────────────
IFTHENPAY_MBWAY_KEY=
IFTHENPAY_MB_KEY=
IFTHENPAY_CALLBACK_CHAVE=

# ─────────────────────────────────────────────────────────────
# ÁREA DA DIREÇÃO (/direcao)
# Palavra-passe que o Presidente escreve para publicar.
# DIRECAO_SECRET: string longa e aleatória, só do servidor.
#   gerar com: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────
DIRECAO_PASSWORD=
DIRECAO_SECRET=

# ─────────────────────────────────────────────────────────────
# REDES SOCIAIS (Meta — Facebook e Instagram)
# Sem estas variáveis o site fica em modo demonstração: mostra o
# que iria publicar, mas não publica nada.
# ─────────────────────────────────────────────────────────────
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=
META_GRAPH_VERSION=v21.0

# ─────────────────────────────────────────────────────────────
# MAKE.COM — publicação no Facebook e Instagram
# Caminho escolhido pelo clube: o Make já tem aprovação da Meta,
# evitando app review e chaves que expiram.
#   MAKE_WEBHOOK_URL     → URL do módulo "Custom webhook" do cenário
#   MAKE_WEBHOOK_SEGREDO → filtro no Make descarta quem não o envie
#                          gerar com: openssl rand -hex 24
# ─────────────────────────────────────────────────────────────
MAKE_WEBHOOK_URL=
MAKE_WEBHOOK_SEGREDO=
