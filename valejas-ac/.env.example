# ─────────────────────────────────────────────────────────────────
# Variáveis de ambiente — Website Valejas AC
#
# Copiar para `.env.local` em desenvolvimento, e repetir na Vercel em
# Settings → Environment Variables para produção. As variáveis só
# entram no deploy SEGUINTE — depois de as pôr, fazer redeploy.
#
# Este ficheiro é o exemplo e vai para o repositório. O `.env.local`
# tem os valores verdadeiros e NUNCA vai — está no .gitignore.
# ─────────────────────────────────────────────────────────────────

# ── Endereço do site ─────────────────────────────────────────────
# Sem isto, as imagens de partilha e o link dos comunicados saem
# relativos, e a Meta não os consegue ir buscar.
NEXT_PUBLIC_SITE_URL="https://valejasac.pt"

# ── Área da Direção ──────────────────────────────────────────────
# Uma conta por pessoa: nome:palavra-passe, separadas por vírgulas.
# O nome fica na sessão e é por ele que se sabe quem publicou o quê.
# As palavras-passe são escritas por pessoas — três palavras sem
# relação entre si funcionam melhor que Vlj!2026#.
DIRECAO_UTILIZADORES="presidente:troca-esta-palavra-passe,comunicacao:troca-esta-tambem"

# Legado: palavra-passe única para toda a gente. Só é usada se
# DIRECAO_UTILIZADORES estiver vazia. Manter enquanto as contas não
# estiverem criadas; apagar depois.
DIRECAO_PASSWORD=""

# Assina o cookie de sessão. Só do servidor:
#   openssl rand -hex 32
DIRECAO_SECRET=""

# ── Email (Resend) ───────────────────────────────────────────────
# EMAIL_PROVIDER=log escreve no terminal e não envia — é o modo de
# desenvolvimento. Em produção, resend.
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""

# Quem assina os envios. Tem de ser um endereço do domínio verificado
# na Resend, senão os emails caem no spam.
EMAIL_REMETENTE="Valejas AC <geral@valejasac.pt>"

# A caixa geral: recebe tudo o que não tiver caixa própria.
EMAIL_CLUBE="geral@valejasac.pt"

# Opcionais — cada assunto para a sua caixa. Faltando, vai para a geral.
#
# Decidido com a Direção a 14/09/2026: presidente@ e direcao@ não
# recebem nada do site. São caixas de trabalho das pessoas, não
# endereços de atendimento.
EMAIL_SOCIOS="geral@valejasac.pt"            # fichas de sócio
EMAIL_INSCRICOES="coordenacao@valejasac.pt"  # inscrições nas modalidades
EMAIL_LOJA="geral@valejasac.pt"              # encomendas de equipamento
EMAIL_PAGAMENTOS="geral@valejasac.pt"        # confirmações de pagamento
#
# A comunicação recebe as cópias dos comunicados e as propostas de
# parceria — está em src/lib/data/socios.ts, não aqui, porque também é
# mostrada no site.

# ── Dados de pagamento do clube ──────────────────────────────────
NEXT_PUBLIC_CLUBE_IBAN=""
NEXT_PUBLIC_CLUBE_MBWAY=""
NEXT_PUBLIC_CLUBE_TITULAR="Valejas Atlético Clube"
NEXT_PUBLIC_CLUBE_ENTIDADE=""

# Quais os métodos que aparecem no formulário, por ordem.
# Acrescentar "referencia" quando a Ifthenpay estiver contratada.
NEXT_PUBLIC_PAGAMENTOS_ATIVOS="mbway,transferencia"

# Taxas de pagamento online. A Direção decidiu absorvê-las: zero.
NEXT_PUBLIC_TAXA_MBWAY_FIXA="0"
NEXT_PUBLIC_TAXA_MBWAY_PCT="0"
NEXT_PUBLIC_TAXA_REFERENCIA_FIXA="0"
NEXT_PUBLIC_TAXA_REFERENCIA_PCT="0"

# ── Ifthenpay ────────────────────────────────────────────────────
#   openssl rand -hex 24   (para a chave de callback)
IFTHENPAY_MBWAY_KEY=""
IFTHENPAY_MB_KEY=""
IFTHENPAY_CALLBACK_CHAVE=""

# ── Sanity (CMS) ─────────────────────────────────────────────────
# Sem isto o site funciona com os dados de exemplo, e as áreas da
# Direção avisam que o CMS não está ligado.
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
SANITY_API_TOKEN=""

# ── Base de dados (encomendas da loja) ───────────────────────────
# Postgres. Qualquer um serve: Neon, Supabase, o que for.
#
# As encomendas ficam aqui e não no CMS porque levam nome, email e
# telemóvel — dados pessoais não podem estar num dataset que qualquer
# pessoa leia. A tabela cria-se sozinha à primeira encomenda.
#
# Sem isto o site continua a vender: a encomenda chega por email na
# mesma, só não aparece em /direcao/encomendas.
DATABASE_URL=""

# ── Make.com (publicar nas redes) ────────────────────────────────
#   openssl rand -hex 24
MAKE_WEBHOOK_URL=""
MAKE_WEBHOOK_SEGREDO=""
